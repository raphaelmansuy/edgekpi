{
  "name": "edgekpi-demo",
  "private": true,
  "license": "Apache-2.0",
  "author": "Raphael MANSUY",
  "version": "0.1.0",
  "type": "module",
  "description": "A React demo of the edgekpi library: build a report, check it, compare three backends, review a migration.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "api": "../../.venv/bin/python -m edgekpi.server --port 8765"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
